      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'gemma4:e2b',\n  stream: false,\n  format: 'json',\n  messages: [\n    {\n      role: 'system',\n      content: 'Return only valid JSON with category, confidence, and language. Category must be billing, technical, or general.'\n    },\n    {\n      role: 'user',\n      content: $json.message\n    }\n  ]\n}) }}",
        "options": {
          "timeout": 60000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
