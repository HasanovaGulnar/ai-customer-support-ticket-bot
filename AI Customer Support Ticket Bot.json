      "name": "HTTP Request",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const ticket = $('Edit Fields').item.json;\n\nlet parsed = {};\nlet aiError = '';\n\ntry {\n  parsed = JSON.parse($json.message.content);\n} catch {\n  aiError = 'Malformed AI JSON';\n}\n\nconst allowed = ['billing', 'technical', 'general'];\nconst aiCategory = String(parsed.category || '').trim().toLowerCase();\n\nconst reportedConfidence = Number(parsed.confidence);\nconst hasConfidence = Number.isFinite(reportedConfidence);\nconst confidence = hasConfidence ? reportedConfidence : 0.8;\n\nconst category =\n  allowed.includes(aiCategory) && (!hasConfidence || confidence >= 0.6)\n    ? aiCategory\n    : 'fallback';\n\nreturn [\n  {\n    json: {\n      ...ticket,\n      category,\n      confidence,\n      language: parsed.language || 'az',\n      ai_raw: $json.message?.content || '',\n      ai_error: aiError,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        -192
      ],
      "id": "38c6437d-a22c-4a62-9642-6ba4eba0e17e",
      "name": "Code in JavaScript"
